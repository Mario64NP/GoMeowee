<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Semantic colors -->
    <Color x:Key="AppBackground">#1f1f1f</Color>
    <Color x:Key="SurfaceBackground">#141414</Color>
    <Color x:Key="AccentColor">#D600AA</Color>
    <Color x:Key="MutedText">#6E6E6E</Color>

    <Color x:Key="BgPrimary">#0a0a0a</Color>
    <Color x:Key="BgCard">#1a1a1a</Color>
    <Color x:Key="TextPrimary">#ffffff</Color>
    <Color x:Key="TextSecondary">#a0a0a0</Color>
    <Color x:Key="Border">#2a2a2a</Color>

    <!-- Typography -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{StaticResource MutedText}"/>
    </Style>

    <!-- Containers -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceBackground}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DateHeaderLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextTransform" Value="Uppercase"/>
        <Setter Property="CharacterSpacing" Value="0.8"/>
        <Setter Property="Margin" Value="4,10,0,4"/>
    </Style>

    <Style x:Key="EventTimeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource AccentColor}"/>
    </Style>

    <Style x:Key="EventTagLabel" TargetType="Label">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource AccentColor}"/>
        <Setter Property="BackgroundColor" Value="#26D600AA"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="TextTransform" Value="Uppercase"/>
    </Style>

    <Style x:Key="EventTitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
        <Setter Property="MaxLines" Value="2"/>
    </Style>

    <Style x:Key="EventLocationLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
    </Style>

    <Style x:Key="InterestedLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style x:Key="LoginField" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="#11FFFFFF"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource MutedText}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Navigation -->
    <Style x:Key="NavHeader" TargetType="Grid">
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource AppBackground}"/>
        <Setter Property="ColumnDefinitions" Value="Auto,*,Auto"/>
    </Style>

    <Style x:Key="NavTitle" TargetType="Label">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="46"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BgCard}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="42"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderColor" Value="{StaticResource Border}"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <Style x:Key="DestructiveButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="#FF4444"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="46"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="BorderColor" Value="#44FF4444"/>
        <Setter Property="BorderWidth" Value="1"/>
    </Style>

    <!-- Avatar -->
    <Style x:Key="AvatarLarge" TargetType="Border">
        <Setter Property="WidthRequest" Value="84"/>
        <Setter Property="HeightRequest" Value="84"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 42"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource BgCard}"/>
    </Style>

    <Style x:Key="AvatarMedium" TargetType="Border">
        <Setter Property="WidthRequest" Value="48"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 24"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource BgCard}"/>
    </Style>

    <Style x:Key="AvatarSmall" TargetType="Border">
        <Setter Property="WidthRequest" Value="36"/>
        <Setter Property="HeightRequest" Value="36"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource BgCard}"/>
    </Style>

    <!-- Posts / Feed -->
    <Style x:Key="PostAuthorName" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="PostTimestamp" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style x:Key="PostMessage" TargetType="Label">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
    </Style>

    <!-- Profile -->
    <Style x:Key="DisplayName" TargetType="Label">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="Username" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style x:Key="BioLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
    </Style>

    <Style x:Key="StatValue" TargetType="Label">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
    </Style>

    <Style x:Key="StatLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
    </Style>

    <!-- Settings -->
    <Style x:Key="SettingsSection" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextTransform" Value="Uppercase"/>
        <Setter Property="CharacterSpacing" Value="0.5"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>

    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BgCard}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>

    <Style x:Key="SettingsRowLabel" TargetType="Label">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- Branding -->
    <Style x:Key="AppLogo" TargetType="Label">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource AccentColor}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
    </Style>

</ResourceDictionary>