<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:GoMeowee.ViewModels"
    x:Class="GoMeowee.Views.EventsPage">

    <CollectionView
            ItemsSource="{Binding EventsByDay}"
            IsGrouped="True"
            Margin="12"
            SelectionMode="Single">

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <Label Text="{Binding Header}"/>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border BackgroundColor="Gray"
                    Stroke="Blue"
                    StrokeThickness="1"
                    Padding="12"
                    Margin="16,4"
                    MinimumHeightRequest="144">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="120,12,*" ColumnSpacing="0">
                        <Border Grid.Column="0" WidthRequest="120" HeightRequest="120" VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6"/>
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D600AA" Offset="0.0"/>
                                    <GradientStop Color="#8B008B" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="🎸" FontSize="65" HorizontalOptions="Center" VerticalOptions="Center" Opacity="1"/>
                        </Border>

                        <Image Grid.Column="0" WidthRequest="120" HeightRequest="120" VerticalOptions="Start" Source="{Binding ImageUrl}"/>

                        <VerticalStackLayout Grid.Column="2" Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="🕐" FontSize="14" VerticalOptions="Center"/>
                                    <Label Text="{Binding StartsAt, StringFormat='{0:h:mm tt}'}"/>
                                </HorizontalStackLayout>

                                <Border Grid.Column="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4"/>
                                    </Border.StrokeShape>
                                    <Label Text="Music"/>
                                </Border>
                            </Grid>

                            <Label Text="{Binding Title}" Margin="0,0,0,8"/>

                            <HorizontalStackLayout Spacing="6" Margin="0,0,0,10">
                                <Label Text="📍" VerticalOptions="Center"/>
                                <Label Text="{Binding Location}"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="Black" Margin="0,0,0,10"/>

                            <HorizontalStackLayout Spacing="6">
                                <Label Text="👥" VerticalOptions="Center"/>
                                <Label VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding InterestedCount}"/>
                                            <Span Text=" interested"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
