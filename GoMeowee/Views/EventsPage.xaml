<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:GoMeowee.Converters"
    xmlns:models="http://schemas.gomeowee.com/models"
    xmlns:viewmodels="clr-namespace:GoMeowee.ViewModels"
    x:Class="GoMeowee.Views.EventsPage"
    x:DataType="viewmodels:EventsViewModel"
    SafeAreaEdges="All"
    BackgroundColor="{StaticResource AppBackground}">
    
    <ContentPage.Resources>
        <conv:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
    </ContentPage.Resources>

    <CollectionView
            ItemsSource="{Binding EventsByDay}"
            IsGrouped="True"
            Margin="8,0"
            SelectionMode="Single"
            SelectionChanged="OnEventSelected"
            VerticalScrollBarVisibility="Never">

        <!-- Group header -->
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="models:EventsDayGroup">
                <Label
                        Text="{Binding Header}"
                        Style="{StaticResource DateHeaderLabel}"/>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <!-- Event item -->
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:EventListItemDto">
                <Grid Padding="0">
                    <Border BackgroundColor="{StaticResource BgCard}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            Padding="12"
                            MinimumHeightRequest="144"> 
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="120,12,*" ColumnSpacing="0">
                            <Grid Grid.Column="0" WidthRequest="120" HeightRequest="120">
                                <Border IsVisible="{Binding HasImage, Converter={StaticResource InvertedBoolConverter}}" StrokeShape="RoundRectangle 6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#D600AA" Offset="0.0"/>
                                            <GradientStop Color="#8B008B" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="🎸" FontSize="65" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Image Source="{Binding FullImageUrl}" IsVisible="{Binding HasImage}" 
                                       WidthRequest="120" HeightRequest="120" Aspect="AspectFill" />
                            </Grid>

                            <Grid Grid.Column="2" RowDefinitions="Auto, Auto, Auto, 1, Auto" RowSpacing="4">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🕐" FontSize="14" TextColor="{StaticResource AccentColor}" VerticalOptions="Center"/>
                                        <Label Text="{Binding StartsAt, StringFormat='{0:h:mm tt}'}" Style="{StaticResource EventTimeLabel}"/>
                                    </HorizontalStackLayout>

                                    <Border Grid.Column="1" StrokeShape="RoundRectangle 4">
                                        <Label Text="{Binding Category}" Style="{StaticResource EventTagLabel}"/>
                                    </Border>
                                </Grid>

                                <Label Grid.Row="1" Text="{Binding Title}" Style="{StaticResource EventTitleLabel}" Margin="0,0,0,8"/>

                                <Grid Grid.Row="2" ColumnDefinitions="Auto, *" ColumnSpacing="6" Margin="0,0,0,10">
                                    <Label Text="📍" FontSize="14" TextColor="{StaticResource AccentColor}" VerticalOptions="Center"/>
                                    <Label Text="{Binding Location}" Grid.Column="1" Style="{StaticResource EventLocationLabel}"/>
                                </Grid>

                                <BoxView Grid.Row="3" HeightRequest="1" Color="{StaticResource Border}" Margin="0,0,0,10"/>

                                <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <Label Text="👥" FontSize="13" VerticalOptions="Center"/>
                                    <Label VerticalOptions="Center" Grid.Column="1">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding InterestedCount}" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" FontSize="12"/>
                                                <Span Text=" interested" TextColor="{StaticResource TextSecondary}" FontSize="12"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
