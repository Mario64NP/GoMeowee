<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoMeowee.Views.ProfilePage">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="24">

            <!-- Header -->
            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Your Profile"
                    FontSize="28"
                    FontAttributes="Bold" />

                <Label
                    Text="Account and app settings"
                    FontSize="14"
                    Opacity="0.7" />
            </VerticalStackLayout>

            <!-- Account card -->
            <Border
                Padding="16"
                CornerRadius="16"
                HasShadow="False"
                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#1E1E1E}">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Account"
                        FontAttributes="Bold" />

                    <Button
                        Text="Settings"
                        HorizontalOptions="Fill"
                        Clicked="OnSettingsClicked" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>