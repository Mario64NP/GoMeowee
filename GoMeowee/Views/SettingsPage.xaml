<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoMeowee.Views.SettingsPage">
    
    <VerticalStackLayout
        Padding="24"
        Spacing="24">

        <Label
            Text="Settings"
            FontSize="28"
            FontAttributes="Bold" />

        <VerticalStackLayout Spacing="12">
            <Label Text="General" FontAttributes="Bold" />

            <!-- future toggles go here -->
            <Label
                Text="More settings coming later"
                Opacity="0.6" />
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Opacity="0.2" />

        <Button
            Text="Log out"
            TextColor="Red"
            Clicked="OnLogoutClicked" />

    </VerticalStackLayout>
</ContentPage>