<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:GoMeowee.Converters"
             xmlns:models="http://schemas.gomeowee.com/models"
             xmlns:viewmodels="clr-namespace:GoMeowee.ViewModels"
             x:Name="editProfilePage"
             x:Class="GoMeowee.Views.EditProfilePage"
             x:DataType="viewmodels:EditProfileViewModel">

    <ContentPage.Resources>
        <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <conv:AvatarConverter x:Key="AvatarConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Navigation Header -->
        <Grid Style="{StaticResource NavHeader}">
            <Button 
                Text="&#xE0A6;"
                FontFamily="SegoeFluentIcons"
                Command="{Binding GoBackCommand}" 
                Style="{StaticResource IconButton}"
                VerticalOptions="End"/>
            <Label 
                Grid.Column="1" 
                Text="Edit Profile" 
                Style="{StaticResource NavTitle}"/>
            <Button
                Grid.Column="2"
                Text="&#xE105;"
                FontFamily="SegoeFluentIcons"
                TextColor="{StaticResource AccentColor}"
                Command="{Binding SaveChangesCommand}"
                Style="{StaticResource IconButton}"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="24">

                <!-- Avatar Section -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Grid>
                        <Border Style="{StaticResource AvatarLarge}">
                            <Image 
                                Source="{Binding FullAvatarUrl, Converter={StaticResource AvatarConverter}}"
                                Aspect="AspectFill">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UpdateAvatarCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>

                        <!-- Edit Badge -->
                        <Border 
                            BackgroundColor="{StaticResource AccentColor}" 
                            StrokeThickness="2"
                            Stroke="{StaticResource BgCard}"
                            StrokeShape="RoundRectangle 14"
                            HeightRequest="28"
                            WidthRequest="28"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Padding="0">
                            <Label 
                                Text="📷" 
                                FontSize="12" 
                                HorizontalOptions="Center" 
                                VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    <Label 
                        Text="Change photo" 
                        FontSize="13" 
                        TextColor="{StaticResource AccentColor}" 
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Public Info Section -->
                <VerticalStackLayout Spacing="0">
                    <Label Text="Public Info" Style="{StaticResource SettingsSection}"/>
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Display Name" Style="{StaticResource MutedLabel}"/>
                            <Entry 
                                Text="{Binding DisplayName}" 
                                Placeholder="Your name"
                                Style="{StaticResource LoginField}"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Border}"/>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Bio" Style="{StaticResource MutedLabel}"/>
                            <Editor 
                                Text="{Binding Bio}" 
                                Placeholder="Tell us about yourself..."
                                AutoSize="TextChanges"
                                Style="{StaticResource BioField}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Interests Section -->
                <VerticalStackLayout Spacing="0">
                    <Label Text="Tags" Style="{StaticResource SettingsSection}"/>
                    <VerticalStackLayout Spacing="16">

                        <!-- Add Tag Input -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry 
                                Text="{Binding NewTag}" 
                                Placeholder="Add a tag..."
                                Style="{StaticResource LoginField}"
                                ReturnCommand="{Binding AddTagCommand}"/>

                            <Button 
                                Text="Add" 
                                Grid.Column="1"
                                Command="{Binding AddTagCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="46"
                                VerticalOptions="Start"/>
                        </Grid>

                        <!-- Tags List -->
                        <FlexLayout Direction="Row" Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding Tags}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource Tag}">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label 
                                                Text="{Binding ., StringFormat='#{0}'}" 
                                                TextColor="{StaticResource TextPrimary}"
                                                FontSize="16" Margin="5,0,0,0"
                                                VerticalTextAlignment="Center"/>

                                            <Button 
                                                Text="&#xE10A;"
                                                FontFamily="SegoeFluentIcons"
                                                MaximumHeightRequest="24" 
                                                MaximumWidthRequest="24"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                Padding="0"
                                                FontSize="16"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextSecondary}"
                                                x:DataType="{x:Type viewmodels:EditProfileViewModel}"
                                                Command="{Binding DeleteTagCommand, Source={x:Reference editProfilePage}}"
                                                CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                    <Label 
                        Text="Tags help others find you based on shared interests." 
                        Style="{StaticResource MutedLabel}"
                        Margin="16,8,16,0"/>
                </VerticalStackLayout>

                <!-- Bottom Spacer for scrolling -->
                <BoxView HeightRequest="40" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>