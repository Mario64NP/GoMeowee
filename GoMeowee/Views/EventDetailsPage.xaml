<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:GoMeowee.Converters"
    xmlns:models="clr-namespace:GoMeowee.Models"
    xmlns:viewmodels="clr-namespace:GoMeowee.ViewModels"
    x:Class="GoMeowee.Views.EventDetailsPage"
    x:DataType="viewmodels:EventDetailsViewModel"
    BackgroundColor="{StaticResource AppBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InterestTextConverter x:Key="InterestTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- COVER IMAGE -->
            <Grid HeightRequest="220">
                <Image
                    Source="{Binding FullImageUrl}"
                    Aspect="AspectFill"/>

                <!-- Subtle fade to background -->
                <BoxView VerticalOptions="End" HeightRequest="60">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="{StaticResource AppBackground}" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </Grid>

            <!-- EVENT INFO -->
            <VerticalStackLayout Padding="20" Spacing="14">

                <Label
                    Text="{Binding Title}"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <HorizontalStackLayout Spacing="10">
                    <Label Text="🕐" FontSize="14" />
                    <Label
                        Text="{Binding StartsAt, StringFormat='{0:dddd, MMM d · h:mm tt}'}"
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Label Text="📍" FontSize="14" />
                    <Label
                        Text="{Binding Location}"
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}" />
                </HorizontalStackLayout>

                <!-- INTEREST BUTTON -->
                <Button
                    Text="{Binding IsUserInterested, Converter={StaticResource InterestTextConverter}}"
                    Command="{Binding ToggleInterestCommand}"
                    CornerRadius="10"
                    HeightRequest="46"
                    BackgroundColor="{StaticResource AccentColor}"
                    TextColor="White"
                    FontAttributes="Bold" />

            </VerticalStackLayout>

            <!-- DIVIDER -->
            <BoxView
                HeightRequest="1"
                Margin="20,8"
                Color="{StaticResource Border}" />

            <!-- INTERESTED PEOPLE -->
            <VerticalStackLayout Padding="20" Spacing="12">

                <Label
                    Text="Interested people"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <CollectionView
                    ItemsSource="{Binding InterestedPeople}"
                    SelectionMode="None"
                    Margin="0,4,0,0">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserInterestDto">
                            <Grid
                                ColumnDefinitions="36,10,Auto"
                                Padding="0"
                                Margin="0,20">

                                <!-- Avatar -->
                                <Image
                                    Source="{Binding FullAvatarUrl}"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Aspect="AspectFill">
                                    <Image.Clip>
                                        <EllipseGeometry
                                            Center="18,18"
                                            RadiusX="18"
                                            RadiusY="18" />
                                    </Image.Clip>
                                </Image>

                                <!-- Name + message -->
                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="2">

                                    <HorizontalStackLayout>
                                        <Label
                                            Text="{Binding DisplayName}"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            TextColor="{StaticResource TextPrimary}" />

                                        <Label
                                            Text="{Binding InterestedAtRelative, StringFormat='{0:HH:mm}'}"
                                            ToolTipProperties.Text="{Binding InterestedAt, StringFormat='{0:f}'}"
                                            FontSize="11"
                                            TextColor="{StaticResource TextSecondary}" 
                                            Margin="8,0,0,0"/>
                                    </HorizontalStackLayout>

                                    <Label
                                        Text="{Binding Message}"
                                        FontSize="13"
                                        TextColor="{StaticResource TextPrimary}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2" />
                                </VerticalStackLayout>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
