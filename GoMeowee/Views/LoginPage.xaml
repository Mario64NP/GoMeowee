<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:GoMeowee.ViewModels"
    x:Class="GoMeowee.Views.LoginPage"
    x:DataType="viewmodels:LoginViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AppBackground}">

    <Grid>
        <!-- Center column -->
        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="420"
            Spacing="28"
            Padding="24">

            <!-- Header -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Sign in"
                    Style="{StaticResource PageTitle}" />

                <Label
                    Text="Use your GoMeowee account"
                    Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <!-- Inputs -->
            <!-- <Border Style="{StaticResource Card}"> -->
            <VerticalStackLayout Spacing="14">
                <Entry
                        Placeholder="Username"
                        Text="{Binding Username}" 
                        Style="{StaticResource Login field}"/>

                <Entry
                        Placeholder="Password"
                        IsPassword="True"
                        Text="{Binding Password}" 
                        Style="{StaticResource Login field}"/>
            </VerticalStackLayout>
            <!-- </Border> -->

            <!-- Action -->
            <Button
                Text="Login"
                Command="{Binding LoginCommand}" />

            <!-- Error -->
            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="Red"
                FontSize="13" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
